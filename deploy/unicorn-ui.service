# Runs the Streamlit app on boot. The API key comes from /etc/unicorn.env.
[Unit]
Description=Unicorn HAT web app
Wants=network-online.target
After=network-online.target

[Service]
User=nmargade
WorkingDirectory=/home/nmargade/unicorn
EnvironmentFile=/etc/unicorn.env
ExecStart=/home/nmargade/unicorn-env/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
